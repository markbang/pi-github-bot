# GitHub App settings
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=pi-bot
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-value

# Public URL used in GitHub App configuration
PUBLIC_URL=https://pi-bot.example.com
PORT=3000

# Persistence
DATABASE_URL=postgres://pi_bot:pi_bot@postgres:5432/pi_bot
REDIS_URL=redis://redis:6379
SETUP_TOKEN=replace-with-a-long-random-admin-token

# pi provider credentials. Use one provider and its matching key.
PI_PROVIDER=anthropic
PI_MODEL=claude-sonnet-4-5
PI_API_KEY=replace-with-provider-api-key
PI_THINKING_LEVEL=medium
PI_TIMEOUT_MINUTES=15
PI_MAX_CONCURRENCY=2
# Must be true before any repository setting can enable local agent writes.
ALLOW_AGENT_WRITES=false
